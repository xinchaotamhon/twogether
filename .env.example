# Temporary default: no Supabase writes, FSRS scheduling, or streak. Wrong cards live only in this tab.
VITE_STUDY_MODE=session

# Later rollback to the durable cloud path: set VITE_STUDY_MODE=fsrs.
# Cloud mode uses one-time device pairing; daily use then needs no email or PIN.
# These are safe browser-side values; never place a Supabase service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_SYNC_MODE=cloud
